# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Gonka — pick one of two transport modes:
#
# (a) Decentralised SDK path — the gonka-openai client signs every request
#     with your secp256k1 key and discovers endpoints from a source URL
#     (a real Gonka network node, not api.gonkascan.com). Both required.
#GONKA_PRIVATE_KEY=
#GONKA_SOURCE_URL=
# Optional: override SDK endpoint discovery ("url;address[,url;address...]")
#GONKA_ENDPOINTS=
# Optional: turn on ICS23 proof verification during endpoint discovery.
#GONKA_VERIFY_PROOF=1
#
# (b) Centralised router path — bearer token issued by router.gonkascan.com.
#     Used automatically when GONKA_PRIVATE_KEY/GONKA_SOURCE_URL are unset.
GONKA_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# ─── Daily S&P 500 app (app/) ───────────────────────────────────────────
# When TRADINGAGENTS_LLM_PROVIDER is unset, the runner defaults to
# Gonka + moonshotai/Kimi-K2.6. To pin to a different provider/model:
#TRADINGAGENTS_LLM_PROVIDER=gonka
#TRADINGAGENTS_DEEP_THINK_LLM=moonshotai/Kimi-K2.6
#TRADINGAGENTS_QUICK_THINK_LLM=moonshotai/Kimi-K2.6

# Override the static top-20 ticker list (comma-separated).
#SP500_TICKERS=NVDA,AAPL,MSFT,GOOGL,AMZN

# Override the SQLite path (default: ~/.tradingagents/app/decisions.sqlite3).
#TRADINGAGENTS_APP_DB=/var/lib/tradingagents/decisions.sqlite3

# APScheduler tuning. Default: weekdays 16:30 America/New_York, top 20.
#TRADINGAGENTS_APP_CRON_HOUR=16
#TRADINGAGENTS_APP_CRON_MINUTE=30
#TRADINGAGENTS_APP_CRON_DOW=mon-fri
#TRADINGAGENTS_APP_TIMEZONE=America/New_York
#TRADINGAGENTS_APP_TOP_N=20
#TRADINGAGENTS_APP_RUN_ON_START=false
# Number of concurrent ticker analyses. Default 1 (serial). Each worker
# runs its own TradingAgentsGraph instance — ~4-8 is a reasonable upper
# bound before yfinance and the single Gonka TA start pushing back.
#TRADINGAGENTS_APP_MAX_WORKERS=4

# Per-ticker retry policy for transient upstream failures (router peer-closed,
# 502 Bad Gateway, Gonka nonce_finished=false, empty stream, etc.). See
# dev_notes/sp500-run-2026-05-15.md for the failure taxonomy the whitelist
# is built from. Non-retryable failures (BadRequestError, GraphRecursionError,
# code bugs) always fail fast.
#TRADINGAGENTS_APP_MAX_RETRIES=3           # extra attempts after the first try
#TRADINGAGENTS_APP_RETRY_BACKOFF=5         # first sleep, seconds (exp ×3: 5/15/45)
#TRADINGAGENTS_APP_RETRY_BACKOFF_MAX=60    # cap per sleep, seconds

# LangGraph node-level retry — re-runs a single failing graph node
# instead of the whole ticker pipeline.
#TRADINGAGENTS_NODE_RETRY_ATTEMPTS=3       # attempts per node, including the first

# Degenerate-output detection. When on, an analyst / manager report that
# is a repetition loop or token salad is rejected (DegenerateOutputError,
# node-retried). OFF by default — on a bad backend day it turns silently
# degraded reports into hard run failures. Set to 1 to enforce.
#TRADINGAGENTS_DETECT_DEGENERATE_OUTPUT=0
