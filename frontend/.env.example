# Where the BROWSER should issue API requests to. Leave UNSET for the
# default same-origin reverse-proxy setup (the Nitro server proxies
# /api/** to the FastAPI backend on 127.0.0.1:8000 via nuxt.config.ts
# routeRules). Only set this if the backend lives on a different origin
# (e.g. a separate api.* subdomain with CORS configured server-side).
# NUXT_PUBLIC_API_BASE=https://api.example.com
